<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FluentKnowledge_WEB</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/_LayoutHome.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <div class="nav-bar-and-search-wrapper">
            <div class="nav-bar">
                <a class="choice-link logo-choice" asp-area="" asp-page="/Welcome/Index">FluentKnowledge</a>
                <a class="choice-link active-choice second-choice" asp-area="" asp-page="/Welcome/Index">Learning</a>
                <a class="choice-link third-choice" asp-area="" asp-page="/Welcome/Index">Editing</a>
                <a class="choice-link fourth-choice" asp-area="" asp-page="/Welcome/Index">Library</a>
            </div>
            <div class="custom-input-wrapper">
                <input type="text" id="search-by-side" class="custom-input" placeholder="Search" />
            </div>
        </div>
        <div class="right-buttons-wrapper">
            <div class="username-holder">
                Name
            </div>
            <div class="more-info-button">
                
            </div>
        </div>
    </header>
    <div class="content-wrapper">
        @RenderBody()
    </div>
</body>
</html>
